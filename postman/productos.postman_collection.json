{
  "info": {
    "name": "DSY1104 Productos Express",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Listar",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos",
        "header": []
      }
    },
    {
      "name": "Crear",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/productos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cuaderno\",\n  \"precio\": 2500,\n  \"stock\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('productoId', pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar por id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos/{{productoId}}",
        "header": []
      }
    },
    {
      "name": "Actualizar",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/productos/{{productoId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cuaderno grande\",\n  \"precio\": 3500,\n  \"stock\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Eliminar",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/productos/{{productoId}}",
        "header": []
      }
    },
    {
      "name": "Validación: precio negativo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/productos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cuaderno\",\n  \"precio\": -1,\n  \"stock\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
